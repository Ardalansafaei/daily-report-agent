# Copy to .env locally. Do not commit .env or put real values in this file.

# GitLab API and wiki
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=replace-with-personal-access-token
GITLAB_TASKS_PROJECT=group/subgroup/project
WIKI_REPO_RELATIVE_PATH=group/subgroup/wiki-project.wiki

# Optional process-scoped local HTTP CONNECT proxy
HTTP_PROXY_URL=http://127.0.0.1:10808

# Stage SQL Server — used only for SELECT and metadata through the documented tunnel
STAGE_DB_HOST=sql-host.example.internal
STAGE_DB_PORT=1433
STAGE_DB_USER=readonly-user
STAGE_DB_PASSWORD=replace-with-readonly-password
STAGE_DB_ENCRYPT=true
STAGE_DB_TRUST_SERVER_CERTIFICATE=true

# Staging business API — use only when supplied/authorized for the current task
STAGE_ACCOMMODATION_API_BASE_URL=https://gateway.example.com/accommodation
STAGE_ACCOMMODATION_BEARER_TOKEN=replace-with-temporary-bearer-token
